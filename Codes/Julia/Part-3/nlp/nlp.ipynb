      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": [
              "0.71191657f0"
            ]
          },
          "metadata": {},
          "execution_count": 27
        }
      ],
      "source": [
        "king = get_word_vector(\"king\")\n",
        "queen = get_word_vector(\"queen\")\n",
        "man = get_word_vector(\"man\")\n",
        "woman = get_word_vector(\"woman\")\n",
        "\n",
        "cosine_similarity(king - man + woman, queen)"
      ]
    },
